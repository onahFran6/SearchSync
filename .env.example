# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=searchsync
POSTGRES_USER=searchsync_app
POSTGRES_PASSWORD=changeme
POSTGRES_REPLICATION_USER=searchsync_repl
POSTGRES_REPLICATION_PASSWORD=changeme

# Stage 4: one dedicated, non-superuser login role per new service schema
# (saga/inventory/payments). See docs/clarification/stage-04-ownership-decision.md.
SAGA_DB_USER=searchsync_saga_app
SAGA_DB_PASSWORD=changeme
INVENTORY_DB_USER=searchsync_inventory_app
INVENTORY_DB_PASSWORD=changeme
PAYMENTS_DB_USER=searchsync_payments_app
PAYMENTS_DB_PASSWORD=changeme

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONNECT_URL=http://localhost:8083
PRODUCTS_TOPIC=searchsync.public.products
PRODUCTS_CONSUMER_GROUP=searchsync-indexer
PRODUCTS_DLQ_TOPIC=searchsync.dlq.products
ORDER_EVENTS_TOPIC=searchsync.outbox.event.orders
ORDER_EVENTS_CONSUMER_GROUP=searchsync-notifications
ORDER_EVENTS_DLQ_TOPIC=searchsync.dlq.orders

# Stage 4: saga coordinator <-> Inventory/Payments commands and events,
# plus the coordinator's own notification topic back to Orders. One topic
# per message type (same granularity as ORDER_EVENTS_TOPIC/OrderCreated
# above), so no consumer ever needs to inspect a Kafka header to know which
# struct to decode.
RESERVE_INVENTORY_TOPIC=searchsync.outbox.event.reserve_inventory
RELEASE_INVENTORY_TOPIC=searchsync.outbox.event.release_inventory
AUTHORIZE_PAYMENT_TOPIC=searchsync.outbox.event.authorize_payment
SAGA_TRANSITIONED_TOPIC=searchsync.outbox.event.saga_transitioned
INVENTORY_RESERVED_TOPIC=searchsync.outbox.event.inventory_reserved
INVENTORY_REJECTED_TOPIC=searchsync.outbox.event.inventory_rejected
INVENTORY_RELEASED_TOPIC=searchsync.outbox.event.inventory_released
INVENTORY_RELEASE_FAILED_TOPIC=searchsync.outbox.event.inventory_release_failed
PAYMENT_AUTHORIZED_TOPIC=searchsync.outbox.event.payment_authorized
PAYMENT_DECLINED_TOPIC=searchsync.outbox.event.payment_declined

SAGA_CONSUMER_GROUP=searchsync-saga-coordinator
SAGA_DLQ_TOPIC=searchsync.dlq.saga
INVENTORY_CONSUMER_GROUP=searchsync-inventory
INVENTORY_DLQ_TOPIC=searchsync.dlq.inventory
PAYMENTS_CONSUMER_GROUP=searchsync-payments
PAYMENTS_DLQ_TOPIC=searchsync.dlq.payments
ORDERS_SAGA_CONSUMER_GROUP=searchsync-orders-saga
ORDERS_SAGA_DLQ_TOPIC=searchsync.dlq.orders_saga

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
PRODUCTS_INDEX=products

# API
API_ADDR=:8081
ORDERS_API_ADDR=:8082
# Stage 4: local-only dev endpoints (POST /dev/inventory/release-failures,
# POST /dev/payments/mode). Never expose these beyond localhost.
INVENTORY_API_ADDR=:8084
PAYMENTS_API_ADDR=:8085
